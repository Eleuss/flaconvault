# apps/verify — copy to .env for LOCAL DEVELOPMENT (simulator on, factory keys, demo seed).
# python-dotenv: keep comments on their own lines (an inline comment after an empty value becomes the value).
# Never put production secrets here: production (Railway) sets its own FV_MASTER_KEY, FV_SERVER_ED25519_SEED and
# FV_ADMIN_TOKEN, with FV_KEY_MODE=sdmbackend and FV_DEV_SIMULATOR=false (see apps/verify/README.md).

# 16 byte hex master key. factory: ignored (public null keys). diversified: AN10922 input. sdmbackend: master key of the
# NFC Developer App (nfcdeveloper.com) / icedevml sdm-backend — tag keys are derived from it (libsdm/derive.py).
FV_MASTER_KEY=00000000000000000000000000000000
# factory (plain mirror, null keys — simulator only) | diversified (plain mirror, AN10922) | sdmbackend (encrypted SUN as
# written by the NFC Developer App — production). Startup refuses factory without the simulator, and the simulator with
# diversified/sdmbackend keys (unless FV_ALLOW_SIM_WITH_REAL_KEYS=true against a local validator).
FV_KEY_MODE=factory
# sdmbackend only: legacy = NFC Developer App / sdm-backend default (pbkdf2, libsdm/legacy_derive.py) | standard = libsdm/derive.py
FV_SDM_DERIVE=legacy
# 32 byte hex, DEV ONLY — never the seed registered on chain (with the simulator on and FV_PROGRAM_ID set, startup
# refuses a seed whose public key is a live server key of that cluster's registry). Generate:
#   python -c "import os;print(os.urandom(32).hex())"
FV_SERVER_ED25519_SEED=
FV_SERVER_KEY_ID=1
# local development only — off by default; with it off the server refuses to start on an all-zero FV_MASTER_KEY or factory keys
FV_DEV_SIMULATOR=true
# load docs/seed into an empty database even with the simulator off (demo deployments only); the simulator implies it
FV_SEED_DEMO=false
# tests against a LOCAL validator only: allow the simulator together with diversified/sdmbackend keys. Refused when
# FV_PROGRAM_ID is set and FV_SOLANA_RPC is not localhost/127.0.0.1. Never combine it with the production master key or seed.
FV_ALLOW_SIM_WITH_REAL_KEYS=false
# x-admin-token for POST /api/reconcile, /api/admin/* and POST /api/dev/reset — all three answer 403 while it is empty
# (dev/reset too: set a local token to reset the simulator database, e.g. python -c "import secrets;print(secrets.token_urlsafe(32))")
FV_ADMIN_TOKEN=
FV_NONCE_TTL_S=90
# Arweave via Irys (apps/verify/irys sidecar). FV_IRYS_KEY = path to a Solana keypair json, or "default" for ~/.config/solana/id.json.
# Uploads happen only when FV_ARWEAVE=true AND FV_IRYS_KEY (or FV_IRYS_KEY_JSON) is set; failures never break the scan
# flow, they are logged as errors and reported in GET /api/admin/status.
FV_ARWEAVE=false
FV_IRYS_KEY=
FV_ARWEAVE_TIMEOUT_S=60
# devnet | mainnet (Irys devnet uploads are pruned after ~60 days)
FV_IRYS_NETWORK=devnet
FV_SOLANA_RPC=https://api.devnet.solana.com
# after deploy
FV_PROGRAM_ID=
# escrow program (LIST…DISPUTE events are verified against its transactions)
FV_ESCROW_PROGRAM_ID=9vabByStbAqKH6sM6fuf8HhfGZbV3993Ncp3uZScexKL
FV_DB_PATH=./data/flaconvault.db
FV_MEDIA_DIR=./data/media
# POST /api/media budgets: free space that must stay on the media volume (507 storage_full below it), bytes per client
# IP (IPv6: per /64) and day (429 media_limited), bytes for the whole server per hour (503 media_busy)
FV_MEDIA_MIN_FREE_BYTES=268435456
FV_MEDIA_MAX_BYTES_PER_IP_DAY=209715200
FV_MEDIA_MAX_BYTES_PER_HOUR=2147483648
# kept seal frames that no pending, confirmed or still recoverable failed scan references are deleted by the reconcile
# job after this many seconds (default 7 days; 0 = keep them forever). Staged uploads go when their session nonce expires.
FV_MEDIA_RETENTION_S=604800
# demo seed file (the default docs/seed/passports.json; also what POST /api/admin/purge-seed recognises)
# FV_SEED_PATH=
# node binary for the Irys sidecar (default ~/.local/node/bin/node, else node from PATH)
# FV_NODE_BIN=
# where /t redirects to
FV_WEB_URL=http://localhost:3000
# host baked into tag URLs
FV_VERIFIER_HOST=http://localhost:8787
FV_CORS_ORIGINS=http://localhost:3000
# reconcile job (briefing §10): seconds between cycles (0 = manual POST /api/reconcile only), and how long a pending event may wait for its on-chain confirmation
FV_RECONCILE_INTERVAL_S=60
FV_RECONCILE_TIMEOUT_S=600
# hosted deployments (Railway): the Irys keypair inline instead of a file path (64-number JSON array)
FV_IRYS_KEY_JSON=
# accept 24-byte (LRP) picc_data; production stickers are AES
FV_SDM_LRP=false
# per client IP (IPv6: per /64): requests per minute on every POST route (the /api/dev/* simulator routes included),
# GET /t and the resume GET /api/verify/<id>; unverified SEAL_DEAD reports per hour
FV_RATE_LIMIT_PER_MIN=60
FV_REPORT_LIMIT_PER_HOUR=3
# proxies in front of the app (X-Forwarded-For is only read when the socket peer is a private address)
FV_TRUSTED_PROXY_HOPS=1
# request body limit in bytes for every route and method (413 request_too_large); POST /api/media has its own limit
FV_MAX_JSON_BODY=65536
# commit shown as `build` by GET /health. Deploys are manual (`railway up`), which sets no commit: set this to
# `git rev-parse HEAD` before each deploy (docs/deploy.md). RAILWAY_GIT_COMMIT_SHA is used only when this is empty.
FV_BUILD_SHA=
