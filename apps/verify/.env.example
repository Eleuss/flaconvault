# apps/verify — copy to .env. Mirrors the apps/verify section of the root /.env.example.
# python-dotenv: keep comments on their own lines (an inline comment after an empty value becomes the value).

# Hackathon: factory key, 16 byte hex
FV_MASTER_KEY=00000000000000000000000000000000
# factory | diversified (AN10922)
FV_KEY_MODE=factory
# 32 byte hex — generate: python -c "import os;print(os.urandom(32).hex())"
FV_SERVER_ED25519_SEED=
FV_SERVER_KEY_ID=1
# until hardware arrives
FV_DEV_SIMULATOR=true
FV_NONCE_TTL_S=90
# devnet keypair json (week 2, unused now)
FV_IRYS_KEY=
FV_SOLANA_RPC=https://api.devnet.solana.com
# after deploy
FV_PROGRAM_ID=
FV_DB_PATH=./data/flaconvault.db
# where /t redirects to
FV_WEB_URL=http://localhost:3000
# host baked into tag URLs
FV_VERIFIER_HOST=http://localhost:8787
FV_CORS_ORIGINS=http://localhost:3000
# reconcile job (briefing §10): seconds between cycles (0 = manual POST /api/reconcile only), and how long a SCAN(pending) may wait for its ScanProof PDA
FV_RECONCILE_INTERVAL_S=60
FV_RECONCILE_TIMEOUT_S=600
