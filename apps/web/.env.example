# apps/web — copy to .env.local for LOCAL DEVELOPMENT. Every NEXT_PUBLIC_* value is compiled into the browser bundle:
# never put a secret here.

# verification server as the browser reaches it (local: apps/verify on port 8787)
NEXT_PUBLIC_VERIFY_URL=http://localhost:8787
# verification server as the Next.js server reaches it (server components, Blink routes); unset (or empty) =
# NEXT_PUBLIC_VERIFY_URL. Uncomment only when the server reaches the verifier under another address.
# VERIFY_URL=http://localhost:8787
# public origin of this app (wallet app identity, old-host redirect, Blink links)
NEXT_PUBLIC_CANONICAL_ORIGIN=http://localhost:3000
# Solana JSON-RPC (devnet, or http://127.0.0.1:8899 for a local validator)
NEXT_PUBLIC_SOLANA_RPC=https://api.devnet.solana.com
# flacon and escrow program ids
NEXT_PUBLIC_PROGRAM_ID=7dCr825ibTyE6Y5oPHP2RCmUi5qFPCaKdZmE9TYeAcWL
NEXT_PUBLIC_ESCROW_PROGRAM_ID=9vabByStbAqKH6sM6fuf8HhfGZbV3993Ncp3uZScexKL
# Reown (WalletConnect) Cloud project id; empty = no WalletConnect entry
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# true = simulator console (/dev) and demo tools. The demo tools (dev wallets, burner, airdrop, test images, virtual
# taps) are additionally active only on localhost or after /dev?demo=1 in that browser (apps/web/src/lib/demo.ts).
# Production: false.
NEXT_PUBLIC_DEV_SIMULATOR=true
