{
  "name": "flaconvault",
  "private": true,
  "version": "0.1.0",
  "description": "FlaconVault — NFC seal, indicator card and on-chain passport for collectible perfume bottles.",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/web"
  ],
  "scripts": {
    "proof:build": "npm run build -w @flaconvault/proof",
    "proof:test": "npm run test -w @flaconvault/proof",
    "vectors": "npm run vectors -w @flaconvault/proof",
    "vectors:check": "npm run vectors && git diff --exit-code -- docs/vectors.json docs/enums.json",
    "vision:build": "npm run build -w @flaconvault/vision",
    "build:packages": "npm run proof:build && npm run vision:build",
    "prepare": "npm run build:packages",
    "vision:test": "npm run test -w @flaconvault/vision",
    "test": "npm run proof:test && npm run vision:test",
    "web:dev": "npm run dev -w @flaconvault/web",
    "web:build": "npm run build -w @flaconvault/web",
    "web:lint": "npm run lint -w @flaconvault/web",
    "web:test": "npm run test -w @flaconvault/web",
    "web:typecheck": "tsc --noEmit -p apps/web/tsconfig.json",
    "mocha:unit": "NODE_OPTIONS=--no-experimental-strip-types ts-mocha -p ./tsconfig.json -t 100000 tests/scripts-cli.ts tests/web-escrow-rules.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@anchor-lang/core": "^1.2.0",
    "@solana/web3.js": "^1.98.0",
    "@types/chai": "^4.3.0",
    "@types/mocha": "^10.0.0",
    "@types/node": "^22.0.0",
    "chai": "^4.5.0",
    "mocha": "^10.8.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "ts-mocha": "^10.0.0",
    "ts-node": "^10.9.0",
    "tsx": "^4.19.0",
    "tweetnacl": "^1.0.3",
    "typescript": "^5.7.0"
  },
  "overrides": {
    "react": "$react",
    "react-dom": "$react-dom",
    "@types/react": "^18",
    "@types/react-dom": "^18"
  }
}
