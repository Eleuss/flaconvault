{
  "name": "flaconvault",
  "private": true,
  "version": "0.1.0",
  "description": "FlaconVault — NFC seal, indicator card and on-chain passport for collectible perfume bottles.",
  "workspaces": [
    "packages/*",
    "apps/web"
  ],
  "scripts": {
    "proof:build": "npm run build -w @flaconvault/proof",
    "proof:test": "npm run test -w @flaconvault/proof",
    "vectors": "npm run vectors -w @flaconvault/proof",
    "web:dev": "npm run dev -w @flaconvault/web",
    "web:build": "npm run build -w @flaconvault/web"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@anchor-lang/core": "^1.2.0",
    "@coral-xyz/anchor": "latest",
    "@solana/web3.js": "^1.98.0",
    "@types/chai": "^4.3.0",
    "@types/mocha": "^10.0.0",
    "@types/node": "^22.0.0",
    "chai": "^4.5.0",
    "mocha": "^10.8.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ts-mocha": "^10.0.0",
    "ts-node": "^10.9.0",
    "tsx": "^4.19.0",
    "tweetnacl": "^1.0.3",
    "typescript": "^5.7.0"
  },
  "overrides": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "@types/react": "^18",
    "@types/react-dom": "^18"
  }
}
