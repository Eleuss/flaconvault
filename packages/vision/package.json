  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test src/*.test.ts",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@flaconvault/proof": "*"
  },
  "devDependencies": {
    "@techstark/opencv-js": "5.0.0-release.1",
    "typescript": "^5.7.0",
    "@types/node": "^22.0.0"
  }
}
