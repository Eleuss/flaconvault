  "description": "Indicator reading from a camera frame: ArUco → homography → per-group white balance → ΔE classification (briefing §9). Runs in a Web Worker and in Node (tests).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
